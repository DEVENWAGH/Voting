{
  "name": "voting-dapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n NODE,NEXT -c cyan,green \"yarn hardhat:node\" \"node scripts/wait-and-deploy.js && next dev\"",
    "dev:next-only": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "mocha test/**/*.test.js",
    "compile": "hardhat compile",
    "hardhat:node": "hardhat node --hostname 0.0.0.0",
    "deploy:proxy": "hardhat run scripts/deployProxy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deployProxy.js --network sepolia",
    "deploy:v2-local": "hardhat run scripts/deployV2Impl.js --network localhost",
    "deploy:v2-sepolia": "hardhat run scripts/deployV2Impl.js --network sepolia"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1081.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@tanstack/react-query": "^5.101.2",
    "bcryptjs": "^3.0.3",
    "csv-parse": "^6.2.1",
    "ethers": "^6.15.0",
    "framer-motion": "^12.42.2",
    "imagekit": "^6.0.0",
    "lucide-react": "^0.537.0",
    "mongoose": "^9.2.4",
    "next": "^15.3.3",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^8.0.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-dropzone": "^15.0.0",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "chai": "^6.2.2",
    "concurrently": "^9.2.1",
    "dotenv": "^17.3.1",
    "eslint": "^9.30.1",
    "eslint-config-next": "^15.3.3",
    "globals": "^16.3.0",
    "hardhat": "^2.28.6",
    "hardhat-gas-reporter": "^2.3.0",
    "knip": "^6.15.0",
    "mocha": "^11.7.5",
    "solidity-coverage": "^0.8.17"
  }
}
