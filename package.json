{
  "name": "voting-dapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "mocha test/**/*.test.js",
    "compile": "hardhat compile",
    "hardhat:node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "start:local": "concurrently -k -n NODE,DEPLOY,NEXT -c cyan,yellow,green \"npm run hardhat:node\" \"sleep 3 && npm run deploy:local\" \"sleep 6 && npm run dev\""
  },
  "dependencies": {
    "@metamask/providers": "^22.1.0",
    "@tailwindcss/postcss": "^4.1.11",
    "ethers": "^6.15.0",
    "lucide-react": "^0.537.0",
    "mongoose": "^9.2.4",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "chai": "^6.2.2",
    "concurrently": "^9.2.1",
    "dotenv": "^17.3.1",
    "eslint": "^9.30.1",
    "eslint-config-next": "^15.3.3",
    "globals": "^16.3.0",
    "hardhat": "^2.28.6",
    "hardhat-gas-reporter": "^2.3.0",
    "mocha": "^11.7.5",
    "solc": "^0.8.34",
    "solidity-coverage": "^0.8.17"
  }
}
